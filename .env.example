# ==============================================================================
# PersonaPlex Voice Agent Platform - Environment Configuration (.env)
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Persistence Database URL
# Local SQLite (Async): sqlite+aiosqlite:///data/platform.db
# Production Neon Postgres (Async): postgresql+asyncpg://user:pass@ep-xyz.neon.tech/neondb?ssl=require
DATABASE_URL=sqlite+aiosqlite:///data/platform.db

# PersonaPlex S2S Inference Worker Pool
# Direct connection to local/remote GPU worker (port 8998)
PERSONAPLEX_WORKER_URL=ws://127.0.0.1:8998
PERSONAPLEX_FALLBACK_WORKER_URL=ws://127.0.0.1:8999

# Auto Mock Worker (Windows / zero-GPU local testing)
# When true, automatically starts a loopback mock worker if no GPU worker is reachable
AUTO_MOCK_WORKER=true

# Prompt & SentencePiece Tokenizer Budget
TOKENIZER_PATH=models/tokenizer_spm_32k_3.model
MAX_PROMPT_TOKENS=350
RECOMMENDED_PROMPT_TOKENS=150

# Audio Standards
CLIENT_SAMPLE_RATE=16000
MODEL_SAMPLE_RATE=24000
TELEPHONY_SAMPLE_RATE=8000

# Canonical Timezone
DEFAULT_TIMEZONE=UTC

# Security & Rate Limiting
# Optional API Key (if unset, all local requests are permitted)
API_KEY=
RATE_LIMIT_PER_MINUTE=60
