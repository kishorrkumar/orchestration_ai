# ==============================================================================
# NVIDIA PersonaPlex Orchestration Layer Environment Variables
# ==============================================================================

# Hugging Face Authentication (Required to download weights for nvidia/personaplex-7b-v1)
# Accept the model license at: https://huggingface.co/nvidia/personaplex-7b-v1
HF_TOKEN=hf_your_actual_token_here
HF_HOME=/data/huggingface

# Gateway Server Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
ENVIRONMENT=production

# Optional API Key for Gateway Authentication (leave blank to disable auth)
GATEWAY_API_KEY=

# Backend Worker Endpoints (Comma-separated host:port or id:host:port)
# Each worker serves 1 active stream on a dedicated port
WORKER_ENDPOINTS=127.0.0.1:8998

# Hardware & Engine Options
PERSONAPLEX_DEVICE=cuda
PERSONAPLEX_VOICE_DIR=/data/huggingface/voices

# Storage Directories
CLONED_VOICES_DIR=/data/cloned_voices
